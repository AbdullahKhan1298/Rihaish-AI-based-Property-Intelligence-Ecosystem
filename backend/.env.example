# Copy to backend/.env. Generate a unique SECRET_KEY locally; never commit .env.
SECRET_KEY=
HOST=127.0.0.1
PORT=8000

# DDS launcher explicitly selects rqlite. Legacy default runtime remains SQLite.
RIHAISH_DB_BACKEND=rqlite
RQLITE_URLS=http://127.0.0.1:4001,http://127.0.0.1:4003,http://127.0.0.1:4005
RIHAISH_MAX_INFLIGHT=8

# Leave credentials empty until an authorized mail provider is configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=RIHAISH Intelligence
KAGGLE_API_TOKEN=
SCRAPE_INTERVAL_DAYS=15
